{
  "name": "swish-live-wall",
  "version": "2.0.0-beta.1",
  "description": "Swish Control — live multiview, protected room health dashboard, incidents, and background room agent",
  "main": "main.js",
  "author": "Swish Breaks",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:server": "node control-server/server-v2.js",
    "start:agent": "node agent/agent.js",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check live-wall-compat.js && node --check control-extras.js && node --check agent/agent.js && node --check control-server/server-v2.js",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist": "electron-builder -mwl --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.swishbreaks.control",
    "productName": "Swish Control",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "live-wall-compat.js",
      "control-extras.js",
      "index.html",
      "styles.css",
      "control-extras.css",
      "agent/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
