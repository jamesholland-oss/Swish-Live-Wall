# Required for Room Agent first-time enrollment.
AGENT_ENROLLMENT_KEY=replace-with-a-long-random-key

# Approved Control Center users.
# Keep this value in Railway variables, not source control.
CONTROL_USERS_JSON=[{"email":"you@example.com","password":"replace-with-strong-password","name":"Control User"}]

# Optional Slack incoming webhook for critical/resolved alerts.
SLACK_WEBHOOK_URL=

# Railway persistent volume mount recommended: /data
DATA_DIR=/data

# Defaults below normally do not need changing.
CONTROL_SESSION_HOURS=12
OFFLINE_AFTER_MS=30000
SAMPLE_INTERVAL_MS=300000
MAX_SAMPLES_PER_AGENT=2016
